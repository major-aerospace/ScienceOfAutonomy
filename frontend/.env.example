# Copy to frontend/.env for local development. On Cloudflare Pages, set these as
# build environment variables instead — they are baked in at build time.

# Backend base URL, no trailing slash (e.g. https://science-of-autonomy-api.onrender.com)
REACT_APP_BACKEND_URL=http://localhost:8001

# Google OAuth "Web application" client ID. Leave empty to hide the Google button.
REACT_APP_GOOGLE_CLIENT_ID=
