# Copy to backend/.env for local development. On Render, set these in the dashboard instead.

# MongoDB connection string (Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority)
MONGO_URL=mongodb://localhost:27017
DB_NAME=science_of_autonomy

# Signs login tokens. At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# The single admin account. No defaults: if these are empty, no admin is created.
# Password must be at least 12 characters. Change it here and restart to rotate it.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google OAuth "Web application" client ID — same value as REACT_APP_GOOGLE_CLIENT_ID.
# Leave empty to turn Google sign-in off. Several IDs can be comma-separated.
GOOGLE_CLIENT_ID=

# Frontend origin(s) allowed to call the API, comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:3000
